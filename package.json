{
    "name": "crash-game-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "integration-test": "jest --config ./jest.integration-test.config.cjs --testPathPattern=tests/integration-tests/ --ci --forceExit --runInBand",
        "test": "jest --testPathPattern=src/ ",
        "test-coverage": "jest --testPathPattern=src/ --collect-coverage",
        "dev": "set APP_NAME=rocketx&& nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "set APP_NAME=spaceflight_service && nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "stats": "nodemon --es-module-specifier-resolution=node --watch ./tests ./tests/rtp/index.js"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "chance": "^1.1.7",
        "lodash": "^4.17.19",
        "prom-client": "^15.1.0",
        "sc-game-base": "4.2.0",
        "sc-instrument": "1.1.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@types/jest": "^29.0.0",
        "babel-jest": "^29.0.0",
        "husky": "^8.0.0",
        "install": "^0.13.0",
        "jest": "^29.0.0",
        "jest-auto-fixture": "^1.0.6",
        "jest-extended": "^3.0.0",
        "jest-junit": "^16.0.0",
        "jest-micro-auto-stub": "^1.0.8",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "^2.0.4",
        "sc-game-service-integration-utils": "^1.3.7"
    },
    "resolutions": {
        "sc-game-base": "4.2.0",
        "sc-base-database": "1.11.3",
        "sc-base-apis": "1.18.2",
        "mongoose": "6.13.6",
        "form-data": "4.0.4",
        "socket.io-parser": "4.0.5",
        "ws": "8.17.1",
        "axios": "0.21.2",
        "sc-common": "2.0.0"
    }
}
